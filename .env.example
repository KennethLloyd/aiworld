# Local application ports. Change either value without editing source files.
API_PORT=3000
WEB_PORT=5173

DATABASE_URL="postgres://postgres:postgres@localhost:5432/aiworld"
BETTER_AUTH_SECRET="your-secret-key-change-in-production"

# Optional deployment overrides. Leave unset for local development, where these
# values are derived from API_PORT and WEB_PORT.
# BETTER_AUTH_URL="https://api.example.com"
# FRONTEND_ORIGIN="https://example.com"
# VITE_API_BASE_URL="https://api.example.com"

# LLM provider configuration. Mock is the safe local/offline default.
LLM_PROVIDER="mock"
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""
LLM_TIMEOUT_MS="30000"
LLM_MAX_RETRIES="2"
LLM_MAX_CONCURRENCY="1"
LLM_RETRY_BASE_DELAY_MS="250"
LLM_RETRY_MAX_DELAY_MS="8000"
LLM_RETRY_JITTER_RATIO="0.25"
LLM_STRUCTURED_OUTPUT="text-json-fallback"
LLM_USAGE_METADATA="optional"

# OpenAI-compatible OpenCode Go profile for provider verification:
# LLM_PROVIDER="openai-compatible"
# LLM_BASE_URL="https://opencode.ai/zen/go/v1"
# LLM_MODEL="deepseek-v4-flash"
# LLM_API_KEY="your-server-side-key"

# Optional local ChatMock profile. ChatMock reads the existing OpenAI OAuth
# session from ~/.codex/auth.json; keep OAuth tokens out of this file.
# LLM_PROVIDER="openai-compatible"
# LLM_BASE_URL="http://127.0.0.1:8000/v1"
# LLM_API_KEY="chatmock-local"
# LLM_MODEL="gpt-5.4-mini"
# LLM_STRUCTURED_OUTPUT="text-json-fallback"

# Simulation scheduler. BullMQ (Redis) is the runtime default; in-process is
# the test/offline override. An empty value falls back to the default.
REDIS_URL="redis://localhost:6379"
SCHEDULER_ADAPTER=bullmq
SCHEDULER_MAX_ATTEMPTS="3"
SCHEDULER_RETRY_BASE_DELAY_MS="1000"
