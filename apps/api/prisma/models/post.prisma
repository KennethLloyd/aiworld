model Post {
  id                String      @id @default(uuid())
  worldId           String
  authorMemberId    String
  title             String
  content           String      @db.Text
  voteScore         Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  world             World       @relation(fields: [worldId], references: [id], onDelete: Cascade)
  author            WorldMember @relation(fields: [authorMemberId], references: [id], onDelete: Restrict)
  comments          Comment[]
  votes             Vote[]

  @@index([worldId, voteScore(sort: Desc), createdAt(sort: Desc), id(sort: Asc)])
  @@index([worldId, createdAt])
  @@index([authorMemberId, createdAt])
  @@map("post")
}
