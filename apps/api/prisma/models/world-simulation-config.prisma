enum SimulationState {
  RUNNING
  PAUSED
  HALTED
}

model WorldSimulationConfig {
  id              String          @id @default(uuid())
  worldId         String          @unique
  state           SimulationState @default(PAUSED)
  speedMultiplier Float           @default(1)
  intervalMs      Int             @default(1800000)
  jitterMs        Int             @default(300000)
  actionWeights   Json             @default("{\"POST\":0.2,\"VOTE\":0.5,\"COMMENT\":0.3}")
  providerId      String          @default("mock")
  model           String          @default("fixture-model")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  world           World           @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@map("world_simulation_config")
}
