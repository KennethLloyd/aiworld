model World {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description Json?
  rules       Json
  topicScope  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members                WorldMember[]
  posts                  Post[]
  simulationLogs         SimulationLog[]
  simulationConfig       WorldSimulationConfig?
  simulationRuntimeState SimulationRuntimeState?
  narrative              WorldNarrative?

  @@map("world")
}

model WorldNarrative {
  worldId           String   @id
  recentEvents      String?  @db.Text
  storySoFar        String?  @db.Text
  continuitySummary String   @default("") @db.Text
  lastPostAt        DateTime?
  lastPostId        String?
  lastCommentAt     DateTime?
  lastCommentId     String?

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@map("world_narrative")
}
