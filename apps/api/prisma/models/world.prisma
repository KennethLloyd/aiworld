model World {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description Json?
  rules       Json
  topicScope  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  characters           Character[]
  posts               Post[]
  simulationLogs      SimulationLog[]
  simulationConfig    WorldSimulationConfig?

  @@map("world")
}
