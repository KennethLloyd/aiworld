{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "target": "ES2023",
    "sourceMap": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "./dist",
    "incremental": true,
    "types": ["node", "jest"],

    /* Path Aliases */
    "paths": {
      "@/*": ["./src/*"],
      "@aiworld/shared": ["../../packages/shared/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
