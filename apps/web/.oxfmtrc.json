{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "sortImports": true,
  "experimentalSortPackageJson": true,
  "ignorePatterns": [
    "dist",
    "dist/**",
    "build",
    "build/**",
    "node_modules/**",
    ".agents/**",
    "*.yml",
    "*.md",
    "src/router/routeTree.gen.ts"
  ]
}
